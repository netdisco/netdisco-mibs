f5AlertsNotifyGroup  NOTIFICATION-GROUP 
    NOTIFICATIONS { 
        hardware-device-fault,
        firmware-fault,
        unknown-alarm,
        drive-fault,
        aom-fault,
        drive-capacity-fault,
        power-fault,
        thermal-fault,
        firmware-update-status,
        drive-utilization,
        datapath-fault,
        dimm-fault,
        module-present,
        psu-fault,
        lcd-fault,
        module-communication-error,
        fips-fault,
        kmip-server-fault,
        kmip-managed-object-error,
        drive-sed-error,
        uefi-communication-error,
        fipsError,
        core-dump,
        reboot,
        incompatible-image,
        login-failed,
        raidEvent,
        txPwrHiAlarm,
        txPwrHiWarn,
        txPwrLoAlarm,
        txPwrLoWarn,
        rxPwrHiAlarm,
        rxPwrHiWarn,
        rxPwrLoAlarm,
        rxPwrLoWarn,
        txBiasHiAlarm,
        txBiasHiWarn,
        txBiasLoAlarm,
        txBiasLoWarn,
        ddmTempHiAlarm,
        ddmTempHiWarn,
        ddmTempLoAlarm,
        ddmTempLoWarn,
        ddmVccHiAlarm,
        ddmVccHiWarn,
        ddmVccLoAlarm,
        ddmVccLoWarn,
        initialization,
        ePVA,
        be2Training,
        up,
        down,
        speed,
        disabled,
        inaccessibleMemory,
        self-signed-key-decryption-failure
    } 
    STATUS    current 
    DESCRIPTION
       "The notifications related to the operation of the F5 System."
    ::= { f5AlertNotificationGroup 1 }

