SYNOLOGY-MAILPLUS-MIB DEFINITIONS ::= BEGIN

IMPORTS
	OBJECT-GROUP, MODULE-COMPLIANCE
		FROM SNMPv2-CONF
	OBJECT-TYPE, Integer32, enterprises, MODULE-IDENTITY
		FROM SNMPv2-SMI
	DisplayString
		FROM SNMPv2-TC;

mailplus MODULE-IDENTITY
	LAST-UPDATED	"202405200000Z"
	ORGANIZATION	"www.synology.com"
	CONTACT-INFO
		 "Synology Inc.
		  Email: snmp@synology.com"
	DESCRIPTION		"Characteristics of the MailPlus Server information"
	::= { synology 201 }

synology	OBJECT IDENTIFIER
	::= { enterprises 6574 }

-- mail count overview
deliveryResult OBJECT IDENTIFIER ::={ mailplus 1 }

deliverySent OBJECT-TYPE
	SYNTAX		Integer32(0..2147483647)
	MAX-ACCESS	read-only
	STATUS		current
	DESCRIPTION "The number of mails sent over the past 10 minutes on the MailPlus Server. (In an HA setup, numbers are sourced from two servers.)"
	::= { deliveryResult 1 }

deliveryReceived OBJECT-TYPE
	SYNTAX		Integer32(0..2147483647)
	MAX-ACCESS	read-only
	STATUS		current
	DESCRIPTION "The number of mails received over the past 10 minutes on the MailPlus Server. (In an HA setup, numbers are sourced from two servers.)"
	::= { deliveryResult 2 }

deliveryBounced OBJECT-TYPE
	SYNTAX		Integer32(0..2147483647)
	MAX-ACCESS	read-only
	STATUS		current
	DESCRIPTION "The number of mails bounced over the past 10 minutes on the MailPlus Server. (In an HA setup, numbers are sourced from two servers.)"
	::= { deliveryResult 3 }

deliveryDeferred OBJECT-TYPE
	SYNTAX		Integer32(0..2147483647)
	MAX-ACCESS	read-only
	STATUS		current
	DESCRIPTION "The number of mails deferred over the past 10 minutes on the MailPlus Server. (In an HA setup, numbers are sourced from two servers.)"
	::= { deliveryResult 4 }

deliveryExpired OBJECT-TYPE
	SYNTAX		Integer32(0..2147483647)
	MAX-ACCESS	read-only
	STATUS		current
	DESCRIPTION "The number of mails expired over the past 10 minutes on MailPlus Server. (In an HA setup, numbers are sourced from two servers.)"
	::= { deliveryResult 5 }

deliveryForwarded OBJECT-TYPE
	SYNTAX		Integer32(0..2147483647)
	MAX-ACCESS	read-only
	STATUS		current
	DESCRIPTION "The number of mails forwarded over the past 10 minutes on MailPlus Server. (In an HA setup, numbers are sourced from two servers.)"
	::= { deliveryResult 6 }

deliveryDeletedInQueue OBJECT-TYPE
	SYNTAX		Integer32(0..2147483647)
	MAX-ACCESS	read-only
	STATUS		current
	DESCRIPTION "The number of mails deleted in queue over the past 10 minutes on MailPlus Server. (In an HA setup, numbers are sourced from two servers.)"
	::= { deliveryResult 7 }

-- threat count
