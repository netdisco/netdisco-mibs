lcos MODULE-IDENTITY
    LAST-UPDATED "202604010453Z"  -- April 1, 2026
    ORGANIZATION
            "LANCOM Systems GmbH"
    CONTACT-INFO
            " 
            Adenauerstrasse 20 / B2
            52146 Wuerselen
            Germany
            
            Phone:  +49 (0)2405 49 93 6 0
            Fax:    +49 (0)2405 49 93 6 99
            E-Mail: info@lancom.eu"
    DESCRIPTION
            "LANCOM Operating System unified manangement information base (MIB)"
    REVISION "202604010453Z"  -- April 1, 2026
    DESCRIPTION
            "The latest version of this MIB module."
